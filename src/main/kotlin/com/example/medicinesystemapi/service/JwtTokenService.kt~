package com.example.medicinesystemapi.service

import com.example.medicinesystemapi.model.User
import io.jsonwebtoken.Jwts
import io.jsonwebtoken.SignatureAlgorithm
import org.springframework.stereotype.Service
import java.util.*

@Service
class JwtTokenService {

    private val secretKey = "" // В реальном приложении храните этот ключ в безопасном месте
    private val expirationTime: Long = 86400000 // 1 день в миллисекундах

    fun generateToken(user: User): String {
        val now = Date()
        val expirationDate = Date(now.time + expirationTime)

        return Jwts.builder()
            .setSubject(user.id.toString())
            .setSubject(user.mhiPolicy)
            .setIssuedAt(now)
            .setExpiration(expirationDate)
            .signWith(SignatureAlgorithm.HS512, secretKey)
            .compact()
    }
}